# Copy to .env and fill in. Never commit .env.

# ── Organization ──
MAIL_DOMAIN=example.com

# ── Exchange (EWS) ──
EWS_URL=https://mail.example.com/EWS/Exchange.asmx
# Service account with the ApplicationImpersonation role in Exchange
SVC_USERNAME=svc-mail-mcp
SVC_PASSWORD=
# UPN used for the LDAP bind (defaults to SVC_USERNAME@MAIL_DOMAIN)
# SVC_UPN=svc-mail-mcp@example.com

# ── OpenID Connect provider (tested with Keycloak) ──
OIDC_ISSUER=https://sso.example.com/realms/Main
OIDC_CLIENT_ID=mail-mcp
# Only for a confidential client; leave empty for a public PKCE client
OIDC_CLIENT_SECRET=
# Override if your provider is not Keycloak-shaped:
# OIDC_AUTH_BASE=https://sso.example.com/realms/Main/protocol/openid-connect
# OIDC_JWKS_URL=https://sso.example.com/realms/Main/protocol/openid-connect/certs

# ── This server ──
PUBLIC_URL=https://mail-mcp.example.com
# Language of replies shown to users: en (default) or fa (Persian)
UI_LANGUAGE=en
PORT=3000
LOGIN_PORT=3001

# ── Active Directory (LDAPS) ──
LDAP_URLS=ldaps://dc1.corp.example.com:636,ldaps://dc2.corp.example.com:636
LDAP_BASE_DN=DC=corp,DC=example,DC=com
LDAPS_CA_PATH=./ldaps-ca.pem

# ── Rooms ──
ROOMS_FILE=./rooms.json
